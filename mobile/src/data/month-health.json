    "wearable": {
      "title": "PMData \u2014 Simula Research Laboratory",
      "url": "https://datasets.simula.no/pmdata/",
      "download": "https://datasets.simula.no/downloads/pmdata.zip",
      "license": "CC BY-NC 4.0",
      "participant": "p01",
      "period": "2019-11-02 through 2019-12-01",
      "authors": "Vajira Thambawita et al. (2020)",
      "fields": [
        "steps",
        "sleep_minutes",
        "bedtime",
        "sedentary_minutes",
        "active_minutes"
      ],
      "method": "Minute step counts summed per source date; longest sleep session assigned to dateOfSleep; active minutes = moderately + very active. Fitbit sedentary minutes are an activity classification, not measured sitting time."
    },
    "scenario": {
      "title": "Healthy Garden fictional companion scenario",
      "fields": [
        "daylight_minutes",
        "feed_minutes",
        "screen_minutes",
        "app_usage",
        "nutrition"
      ],
      "method": "Deterministic fictional demo values; not measured from PMData participants. 14:00 snapshots scale cumulative totals to 55%; sleep is kept complete. No observed intervention or claim of causal improvement."
    }
  },
