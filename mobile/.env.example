# Copy to .env.local (gitignored). Values come from the Supabase project (see docs/SUPABASE_SETUP.md).
# Only the PUBLISHABLE key goes here — never the secret/service_role key.
# Fill these empty placeholders with https://<project-ref>.supabase.co and your public key.
# Then run npm run check:connection from mobile/.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
