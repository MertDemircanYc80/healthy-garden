# Copy to .env.local (gitignored). Values come from the Supabase project (see docs/SUPABASE_SETUP.md).
# Only the PUBLISHABLE key goes here — never the secret/service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional local live coach; leave empty for the prepared offline replay.
# Only use demo scenario data with this gateway. The token is a demo access code, not an API key.
EXPO_PUBLIC_COACH_URL=
EXPO_PUBLIC_COACH_TOKEN=

# Optional terminal replay listener (demo:setup enables it)
EXPO_PUBLIC_DEMO_CONTROL=
