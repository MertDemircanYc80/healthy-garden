{
  "expo": {
    "name": "Healthy Garden",
    "slug": "healthy-garden",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mertdemircan.healthygarden"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DCEBD5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mertdemircan.healthygarden"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Healthy Garden reads your steps, sleep, workouts, time in daylight and meals to grow your garden and suggest personal goals.",
          "NSHealthUpdateUsageDescription": "Healthy Garden does not write to Apple Health.",
          "background": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "scheme": "healthygarden",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#CFE6DF"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
